{
    "schema": "bsv-app",
    "schemaVersion": "1.0",
    "topicManagers": {
        "tm_horse_passport": "./src/topic-managers/identity/EquusVHorsePassportTopicManager.ts"
    },
    "lookupServices": {
        "ls_horse_passport": { 
            "serviceFactory": "./src/lookup-services/identity/EquusVHorsePassportLookupServiceFactory.ts",
            "hydrateWith": "mongo"
        }
    }, 
    "configs": [
        {
            "name": "Local LARS",
            "provider": "LARS",
            "network": "mainnet",
            "run": [
                "backend"
            ]
        },
        {
            "name": "Production",
            "provider": "CARS",
            "CARSCloudURL": "https://cars.babbage.systems",
            "network": "mainnet",
            "deploy": [
                "backend"
            ],
            "projectID": "YOUR_PROJECT_ID"
        }
    ]
}