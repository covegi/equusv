{
    "schema": "bsv-app",
    "schemaVersion": "1.0",
    "topicManagers": {
        "tm_horse_passport": "./src/mod-passport.ts",
        "tm_uhrp": "./src/mod-uhrp.ts"
    },
    "lookupServices": {
        "ls_passport": { 
            "serviceFactory": "./src/mod-passport.ts",
            "hydrateWith": "mongo"
        },
        "ls_uhrp": {
            "serviceFactory": "./src/mod-uhrp.ts",
            "hydrateWith": "mongo"
        }
    }, 
    "configs": [
        {
            "name": "Local LARS",
            "provider": "LARS",
            "network": "mainnet",
            "run": [
                "backend"
            ]
        },
        {
            "name": "Production",
            "provider": "CARS",
            "CARSCloudURL": "https://cars.babbage.systems",
            "network": "mainnet",
            "deploy": [
                "backend"
            ],
            "projectID": "YOUR_PROJECT_ID"
        }
    ]
}