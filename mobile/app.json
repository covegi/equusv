{
  "expo": {
    "name": "EquusV",
    "slug": "equuscert",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/equus-app-icon.png",
    "scheme": "equusv",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.equusv.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "EquusCert behöver kameraåtkomst för att ta hästfoton.",
        "NSPhotoLibraryUsageDescription": "EquusCert behöver åtkomst till bildbiblioteket för att välja hästfoton."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f2f2",
          "image": "./assets/images/equus-splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59fd0b80-5220-485b-b746-50e1949a1e38"
      }
    },
    "owner": "covegi"
  }
}
